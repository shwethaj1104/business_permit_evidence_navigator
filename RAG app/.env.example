# Backend only. Fill secrets locally; never expose these through VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_URI=
MONGODB_DB_NAME=permit_navigator

# Optional discovery only; chat and summaries still use OPENAI_MODEL.
OPENAI_SEARCH_MODEL=gpt-5-nano

# Console application logging: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# local: start the existing polling worker yourself. azure: API starts a one-shot Azure Job.
SYNC_DISPATCH_MODE=local
# Set only in Azure API configuration; keep the resource ID and identity server-side.
AZURE_SYNC_JOB_RESOURCE_ID=
# Optional user-assigned managed identity client ID; blank uses system-assigned identity.
AZURE_CLIENT_ID=

# Exact allowed browser origins for the separately hosted frontend (comma-separated).
CORS_ORIGINS=
